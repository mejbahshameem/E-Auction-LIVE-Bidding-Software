@{
    ViewBag.Title = "My Account";
    Layout = "~/Views/Shared/_mytemplate.cshtml";
}

<title>E-Auction | Account</title>

<section class="account-shell">
    <div class="container">
        @if (Session["log"] != null)
        {
            <div class="account-hero">
                <h1>Welcome back, @Session["log"]</h1>
                <p>Manage your profile, track purchases, and monitor your sales from one place.</p>
            </div>

            <div class="row account-stats">
                <div class="col-sm-3">
                    <div class="account-stat-card">
                        <span class="label">Bought</span>
                        <strong>@ViewBag.BuyCount</strong>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="account-stat-card">
                        <span class="label">Sold</span>
                        <strong>@ViewBag.SoldCount</strong>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="account-stat-card">
                        <span class="label">Live Listings</span>
                        <strong>@ViewBag.LiveCount</strong>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="account-stat-card">
                        <span class="label">Alert Preferences</span>
                        <strong>@ViewBag.AlertCount</strong>
                    </div>
                </div>
            </div>

            <div class="row account-actions">
                <div class="col-sm-6">
                    <a class="account-action-card" href="@Url.Action("EditUser", "Home")">
                        <h3>Edit Profile</h3>
                        <p>Update your account information and contact details.</p>
                    </a>
                </div>
                <div class="col-sm-6">
                    <a class="account-action-card" href="@Url.Action("UserBuyInfo", "Home")">
                        <h3>Purchase History</h3>
                        <p>Review products you won in live auctions.</p>
                    </a>
                </div>
                <div class="col-sm-6">
                    <a class="account-action-card" href="@Url.Action("UserSoldProduct", "Home")">
                        <h3>Sold Products</h3>
                        <p>Track completed sales and buyer records.</p>
                    </a>
                </div>
                <div class="col-sm-6">
                    <a class="account-action-card danger" href="@Url.Action("Deletecl", "Home")">
                        <h3>Delete Account</h3>
                        <p>Close your account permanently.</p>
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="account-hero guest">
                <h1>Account Access</h1>
                <p>Sign in to bid, manage listings, and receive personalized alerts.</p>
            </div>

            <section id="form">
                <div class="row">
                    <div class="col-sm-5 col-sm-offset-1">
                        <div class="login-form account-auth-card">
                            <h2>Login</h2>
                            @using (Html.BeginForm("login", "Home", FormMethod.Post))
                            {
                                <input type="text" placeholder="User Name" name="uname" />
                                <input type="password" placeholder="Password" name="password" />
                                <button type="submit" class="btn btn-default" name="submit">Login</button>
                            }
                        </div>
                    </div>

                    <div class="col-sm-5">
                        <div class="signup-form account-auth-card">
                            <h2>Create Account</h2>
                            @using (Html.BeginForm("Regis", "Home", FormMethod.Post))
                            {
                                <input type="text" placeholder="UserName" name="uname" />
                                <input type="email" placeholder="Email Address" name="mail" />
                                <input type="password" placeholder="Password" name="pword" />
                                <input type="password" placeholder="Retype Password" name="cpword" />
                                <button type="submit" class="btn btn-default" name="submit">Signup</button>
                            }
                        </div>
                    </div>
                </div>
            </section>
        }
    </div>
</section>
