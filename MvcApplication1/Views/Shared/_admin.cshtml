<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>E-Auction Admin</title>

  <link rel="stylesheet" type="text/css" href="~/Content/admintemplate/bootstrap/css/bootstrap.min.css" />
  <link href="~/Content/admintemplate/css/main.css" rel="stylesheet">
  <link href="~/Content/admintemplate/css/modern-admin.css" rel="stylesheet">

  <script type="text/javascript" src="~/Content/admintemplate/js/jquery.js"></script>
  <script type="text/javascript" src="~/Content/admintemplate/bootstrap/js/bootstrap.min.js"></script>
</head>
<body class="admin-body">
  <nav class="navbar navbar-inverse navbar-fixed-top">
    <div class="container">
      <div class="navbar-header">
        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
        </button>
        <a class="navbar-brand" href="@Url.Action("Table", "Admin")">E-Auction Admin</a>
      </div>
      <div class="navbar-collapse collapse">
        <ul class="nav navbar-nav">
          @if (Session["log1"] != null)
          {
            <li><a href="@Url.Action("Table", "Admin")">Dashboard</a></li>
            <li><a href="@Url.Action("BidRequest", "Admin")">Bid Requests</a></li>
            <li><a href="@Url.Action("LiveAuction", "Admin")">Live Auction</a></li>
            <li><a href="@Url.Action("SoldProduct", "Admin")">Sold Products</a></li>
            <li><a href="@Url.Action("UserInfo", "Admin")">Users</a></li>
            <li><a href="@Url.Action("AuctionAlert1", "Admin")">Alerts</a></li>
            <li><a href="@Url.Action("logout", "Admin")">Logout</a></li>
          }
          else
          {
            <li><a href="@Url.Action("Index", "Admin")">Login</a></li>
          }
        </ul>
      </div>
    </div>
  </nav>

  <div class="admin-shell">
    @RenderBody()
  </div>

  <footer id="footerwrap" class="admin-footer">
    <div class="container">
      <div class="row">
        <div class="col-sm-12 col-lg-12">
          <p>E-Auction Admin Panel | Built for modern auction operations</p>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>