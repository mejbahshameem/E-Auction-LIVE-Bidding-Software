@model IEnumerable<MvcApplication1.Models.BidRequest>

@{
    ViewBag.Title = "BidRequest";
    Layout = "~/Views/Shared/_admin.cshtml";
}
<section class="admin-card">
<h2 class="admin-title">Bid Requests</h2>



<table class="admin-table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.SellerName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ProductName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Details)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FileName)
        </th>
        <th>
            Product Image
        </th>
        <th>
            @Html.DisplayNameFor(model => model.BasePrice)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.MaxTime)
        </th>
        <th>Select Operation</th>
         
    </tr>

@foreach (var item in Model) {

    var base64 = Convert.ToBase64String(@item.ImageData);
    var x = String.Format("data:image/jpg;base64,{0}", base64);
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.SellerName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ProductName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Details)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FileName)
        </td>
         <td>
             <img src='@x' alt="" />
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.BasePrice)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.MaxTime)
        </td>
        <td class="admin-actions">
            @Html.ActionLink("Post Live", "postreq", new { id=item.ID })
            @Html.ActionLink("Delete", "Deletereq", new { id=item.ID })
        </td>
    </tr>
}

</table>
</section>