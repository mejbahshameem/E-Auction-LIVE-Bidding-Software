@{
    ViewBag.Title = "Table";
    Layout = "~/Views/Shared/_admin.cshtml";
}
<section class="admin-card">
   <h2 class="admin-title">Admin Dashboard</h2>
   @if(ViewBag.success==1){
   @Html.Raw(TempData["msg"])
}
     @if(ViewBag.success==2){
   @Html.Raw(TempData["msg"])
}

    <div class="admin-kpi-grid">
        <div class="admin-kpi-card">
            <p class="admin-kpi-label">Bid Requests</p>
            <h3 class="admin-kpi-value">@ViewBag.TotalBidRequests</h3>
        </div>
        <div class="admin-kpi-card">
            <p class="admin-kpi-label">Registered Users</p>
            <h3 class="admin-kpi-value">@ViewBag.TotalUsers</h3>
        </div>
        <div class="admin-kpi-card">
            <p class="admin-kpi-label">Live Auctions</p>
            <h3 class="admin-kpi-value">@ViewBag.TotalLive</h3>
        </div>
        <div class="admin-kpi-card">
            <p class="admin-kpi-label">Sold Products</p>
            <h3 class="admin-kpi-value">@ViewBag.TotalSold</h3>
        </div>
        <div class="admin-kpi-card">
            <p class="admin-kpi-label">Auction Alerts</p>
            <h3 class="admin-kpi-value">@ViewBag.TotalAlerts</h3>
        </div>
    </div>

    <div class="admin-action-grid" style="margin-top:16px;">
        <a class="admin-action-tile" href="@Url.Action("BidRequest", "Admin")">
            <span class="admin-action-title">Bid Requests</span>
            <span class="admin-action-subtitle">Review seller submissions</span>
        </a>
        <a class="admin-action-tile" href="@Url.Action("UserInfo", "Admin")">
            <span class="admin-action-title">Registered Users</span>
            <span class="admin-action-subtitle">Manage platform users</span>
        </a>
        <a class="admin-action-tile" href="@Url.Action("LiveAuction", "Admin")">
            <span class="admin-action-title">Live Auction</span>
            <span class="admin-action-subtitle">Track active listings</span>
        </a>
        <a class="admin-action-tile" href="@Url.Action("SoldProduct", "Admin")">
            <span class="admin-action-title">Sold Products</span>
            <span class="admin-action-subtitle">Review closed sales</span>
        </a>
        <a class="admin-action-tile" href="@Url.Action("AuctionAlert1", "Admin")">
            <span class="admin-action-title">Auction Alerts</span>
            <span class="admin-action-subtitle">Watch subscriptions</span>
        </a>
    </div>

</section>