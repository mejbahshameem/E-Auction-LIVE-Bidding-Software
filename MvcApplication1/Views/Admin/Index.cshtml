@{
    ViewBag.Title = "login";
    Layout = "~/Views/Shared/_admin.cshtml";
}
<div class="admin-card" style="max-width:560px; margin:0 auto;">
    <h2 class="admin-title">Admin Login</h2>

    @if (TempData["AdminSetupSuccess"] != null)
    {
        <p class="text-success">@TempData["AdminSetupSuccess"]</p>
    }

    @if (ViewBag.error2 == 1)
    {
        <p class="text-danger">Incorrect user name or password.</p>
    }

    @using (Html.BeginForm("Index", "Admin", FormMethod.Post, new { @class = "admin-form" }))
    {
        <label for="admin-user">User Name</label>
        <input type="text" id="admin-user" name="un" placeholder="User Name" required />

        <label for="admin-password">Password</label>
        <input type="password" id="admin-password" name="pd" placeholder="Password" required />

        <input type="submit" name="submit1" value="Login" />
    }

    <p style="margin-top:12px;">
        Need to create or reset admin credentials from this machine?
        @Html.ActionLink("Open setup page", "SetupAdmin", "Admin")
    </p>
</div>
         